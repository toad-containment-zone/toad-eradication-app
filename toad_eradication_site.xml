<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms" xmlns:entities="http://www.opendatakit.org/xforms/entities">
  <h:head>
    <h:title>Toad Eradication Site</h:title>
    <model odk:xforms-version="1.0.0" entities:entities-version="2024.1.0">
      <instance>
        <data id="toad_eradication_site">
          <site_id/>
          <site_name/>
          <site_lat/>
          <site_lon/>
          <registered_by/>
          <registered_at/>
          <site_notes/>
          <meta>
            <entity dataset="toad_eradication_sites" create="1" id="">
              <label/>
            </entity>
            <instanceID/>
          </meta>
        </data>
      </instance>
      <bind nodeset="/data/site_id" type="string" required="true()"/>
      <bind nodeset="/data/site_name" type="string" required="true()" entities:saveto="site_name"/>
      <bind nodeset="/data/site_lat" type="decimal" required="true()" constraint=". &gt;= -90 and . &lt;= 90" entities:saveto="latitude"/>
      <bind nodeset="/data/site_lon" type="decimal" required="true()" constraint=". &gt;= -180 and . &lt;= 180" entities:saveto="longitude"/>
      <bind nodeset="/data/registered_by" type="string" required="false()" entities:saveto="registered_by"/>
      <bind nodeset="/data/registered_at" type="dateTime" required="true()" entities:saveto="registered_at"/>
      <bind nodeset="/data/site_notes" type="string" required="false()" entities:saveto="site_notes"/>
      <bind nodeset="/data/meta/entity/@id" readonly="true()" type="string"/>
      <setvalue ref="/data/meta/entity/@id" event="odk-instance-first-load" value="uuid()"/>
      <bind nodeset="/data/meta/entity/label" calculate=" /data/site_name " readonly="true()" type="string"/>
      <bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
    </model>
  </h:head>
  <h:body>
    <input ref="/data/site_id">
      <label>Site ID</label>
      <hint>Entity ID (UUID) generated by the app; also shared to teammates by QR code</hint>
    </input>
    <input ref="/data/site_name">
      <label>Site name</label>
      <hint>Short name the team will recognise on later nights</hint>
    </input>
    <input ref="/data/site_lat">
      <label>Site latitude</label>
    </input>
    <input ref="/data/site_lon">
      <label>Site longitude</label>
    </input>
    <input ref="/data/registered_by">
      <label>Registered by</label>
      <hint>Collector name from the app settings</hint>
    </input>
    <input ref="/data/registered_at">
      <label>Registered at</label>
    </input>
    <input ref="/data/site_notes">
      <label>Site notes</label>
    </input>
  </h:body>
</h:html>
